{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    }
  ],
  "functions": {
    "api/notes.js": {
      "includeFiles": "aleph.config.json"
    },
    "api/notes/[id].js": {
      "includeFiles": "aleph.config.json"
    }
  }
}
